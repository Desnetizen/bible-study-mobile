{
  "expo": {
    "name": "Bible Connection",
    "slug": "bible-study-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/darkMode_app_icon.png",
    "scheme": "bibleconnection",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#07111F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.desneitzen.bibleconnection",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.desneitzen.bibleconnection",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2f4565e-7e03-4d2e-8730-0e4de58e714d"
      }
    },
    "owner": "desneitzen",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a2f4565e-7e03-4d2e-8730-0e4de58e714d"
    }
  }
}
