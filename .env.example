# Expo exposes only EXPO_PUBLIC_* values to the app bundle.
# Do not put API_BIBLE_KEY here unless you intentionally want it public.

EXPO_PUBLIC_SCRIPTURE_PROVIDER_URL=https://bible-api.com

# Supabase client config for the app. Use your project's URL and publishable key.
EXPO_PUBLIC_SUPABASE_URL=https://egoctzmgcqsxaagshwrg.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_VU9bp0iwViDfgkwTpKwdoQ_eRMO0XTu

# Legacy fallback if you are still using the old anon key flow.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_VU9bp0iwViDfgkwTpKwdoQ_eRMO0XTu

# API.Bible NKJV requires a private API key. Keep it behind a server/proxy,
# then point EXPO_PUBLIC_SCRIPTURE_PROVIDER_URL at that proxy if needed.
# API_BIBLE_KEY=server_only
# NKJV_BIBLE_ID=licensed_nkjv_bible_id
